# Copy to .env for local development. .env is git-ignored — never commit real values.
# In production these are set in the Render dashboard under Environment.

# --- Instagram / Meta -------------------------------------------------------
# Prefer a Business Manager System User token: it does not expire, unlike the
# 60-day extended user token. Business Settings -> System Users -> Generate token
# with instagram_basic, instagram_content_publish, pages_manage_posts,
# pages_read_engagement, and the Page + IG account assigned as assets.
IG_ACCESS_TOKEN=
IG_USER_ID=17841438053748611
FACEBOOK_PAGE_ID=1160207883850934

# --- Pinterest --------------------------------------------------------------
# v5 access tokens last 30 days; the refresh token lasts 60 and is refreshable
# indefinitely, so store the refresh token and rotate before expiry.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_BOARD_NAME=PiggyMath Tax & Money Tips
# Set to true ONLY for API experiments. Sandbox pins never appear on the live account.
PINTEREST_SANDBOX=false

# --- Publishing -------------------------------------------------------------
# Meta and Pinterest fetch card images over the public internet, so this must be
# a publicly reachable origin. On Render, RENDER_EXTERNAL_URL is used if unset.
PUBLIC_BASE_URL=https://piggymath-social-studio.onrender.com
POST_CRON=0 9 * * *
POST_TIMEZONE=America/New_York
# Render + build the card but do not call the social APIs.
DRY_RUN=false
